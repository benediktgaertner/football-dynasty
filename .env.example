# Kopiere diese Datei nach `.env` und trage deine Werte ein. `.env` wird nie eingecheckt.

# ---------------------------------------------------------------
# Web-App (Vite). Diese Werte landen im Browser – nur öffentliche Schlüssel!
# Supabase-Dashboard → Project Settings → API
# ---------------------------------------------------------------
VITE_SUPABASE_URL=https://<dein-projekt>.supabase.co
# "anon"- bzw. "publishable"-Schlüssel. NIEMALS den Service-Role-/Secret-Schlüssel hier eintragen.
VITE_SUPABASE_ANON_KEY=<anon-oder-publishable-key>
# Adresse des Match-Servers (ab Phase 5/6 verwendet)
VITE_MATCH_SERVER_URL=https://football-dynasty-match.fly.dev

# ---------------------------------------------------------------
# Match-Server (nur serverseitig, z. B. als Fly.io-Secrets setzen)
# ---------------------------------------------------------------
SUPABASE_URL=https://<dein-projekt>.supabase.co
# Service-Role-/Secret-Schlüssel: umgeht RLS. Nur auf dem Server, nie im Frontend.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
# Komma-getrennte Liste erlaubter Web-Origins (Netlify-URL und lokale Entwicklung)
ALLOWED_ORIGINS=https://<deine-seite>.netlify.app,http://localhost:5173
PORT=2567
